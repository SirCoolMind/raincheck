{
  "name": "raincheck-daily-commute",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "key": "node scripts/load-key.mjs",
    "dev": "node scripts/load-key.mjs && vite",
    "api": "php -S 127.0.0.1:8787 -t .",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs dist && node scripts/check-key.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:php": "php tests/php/smoke.php",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "node scripts/record-fixtures.mjs",
    "lint": "eslint src tests/unit",
    "format": "prettier --write src tests",
    "check:key": "node scripts/check-key.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.50",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.8",
    "lighthouse": "^12.8.2",
    "prettier": "^3.10.1",
    "typescript": "5.7",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "maplibre-gl": "^5.24.1"
  }
}
