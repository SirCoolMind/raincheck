  "components": [
    {
      "name": "Month Band",
      "kind": "custom",
      "refersTo": "month-band",
      "description": "Solid ink-teal band holding preset, clock and scrubber.",
      "html": "<div class=\"ds-band\"><div class=\"ds-seg\"><button aria-pressed=\"true\">Morning</button><button>Evening</button><button>Custom</button></div><div class=\"ds-depart\"><span class=\"ds-verb\">Leave</span><span class=\"ds-clock\">07:30</span><span class=\"ds-arrive\">→ 08:30</span></div></div>",
      "css": ".ds-band{background:var(--band,#0e3b4a);color:var(--band-ink,#f3f7f6);padding:16px 16px 12px}.ds-seg{display:inline-flex;background:rgb(0 0 0/.22);border-radius:999px;padding:3px;gap:2px}.ds-seg button{min-height:44px;padding:0 14px;border:0;border-radius:999px;background:transparent;color:var(--band-ink-2,#b4cdd1);font:600 15px/1 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.ds-seg button[aria-pressed='true']{background:var(--band-ink,#f3f7f6);color:var(--band,#0e3b4a)}.ds-seg button:focus-visible{outline:none;box-shadow:0 0 0 2px var(--band,#0e3b4a),0 0 0 4px var(--now,#c13d26)}.ds-depart{display:flex;align-items:baseline;gap:10px;margin-top:12px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-variant-numeric:tabular-nums}.ds-verb{font:600 18px/1 'Barlow Condensed',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--band-ink-2,#b4cdd1)}.ds-clock{font-size:42px;font-weight:600;line-height:.9}.ds-arrive{font-size:16px;font-weight:500;color:var(--band-ink-2,#b4cdd1)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Band-teal action on the sheet.",
      "html": "<button class=\"ds-btn-primary\">Done</button>",
      "css": ".ds-btn-primary{min-height:44px;padding:0 16px;border-radius:6px;border:1px solid var(--band,#0e3b4a);background:var(--band,#0e3b4a);color:var(--band-ink,#f3f7f6);font:600 15px/1 system-ui,sans-serif;cursor:pointer}.ds-btn-primary:hover{background:var(--band-2,#134a5c)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--sheet,#fbfbf9),0 0 0 5px var(--now,#c13d26)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Hairline-bordered sheet button.",
      "html": "<button class=\"ds-btn\">Edit route</button>",
      "css": ".ds-btn{min-height:44px;padding:0 16px;border-radius:6px;border:1px solid var(--rule-strong,#b7beb6);background:var(--sheet,#fbfbf9);color:var(--ink,#14202b);font:600 15px/1 system-ui,sans-serif;cursor:pointer}.ds-btn:hover{background:var(--sheet-2,#f2f4f0)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 3px var(--sheet,#fbfbf9),0 0 0 5px var(--now,#c13d26)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "44px hairline field; vermilion border on focus.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Search a place\">",
      "css": ".ds-input{min-height:44px;padding:0 12px;border-radius:6px;border:1px solid var(--rule-strong,#b7beb6);background:var(--sheet,#fbfbf9);color:var(--ink,#14202b);font:400 16px/1 system-ui,sans-serif;width:100%}.ds-input:focus-visible{outline:none;border-color:var(--now,#c13d26);box-shadow:0 0 0 3px var(--sheet,#fbfbf9),0 0 0 5px var(--now,#c13d26)}"
    },
    {
      "name": "Journey Strip",
      "kind": "custom",
      "refersTo": "stretch-cell-rain",
      "description": "A takwim row: equal flat verdict cells with drawn icons; selected ringed in vermilion.",
      "html": "<div class=\"ds-strip\"><button class=\"ds-cell ds-dry\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4.2\"/><path d=\"M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2\"/></svg></button><button class=\"ds-cell ds-possible\"></button><button class=\"ds-cell ds-rain ds-on\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12a9 9 0 0 1 18 0Z\"/><path d=\"M12 12v6.6a2.2 2.2 0 0 1-4.4 0\"/></svg></button><button class=\"ds-cell ds-heavy\"></button><button class=\"ds-cell ds-nodata\"></button></div>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2px;max-width:320px}.ds-cell{height:48px;border:0;border-radius:3px;display:grid;place-items:center;cursor:pointer;transition:opacity .2s cubic-bezier(.16,1,.3,1)}.ds-cell:focus-visible,.ds-on{outline:none;box-shadow:0 0 0 2px var(--sheet,#fbfbf9),0 0 0 4px var(--now,#c13d26)}.ds-dry{background:var(--v-dry,#eadfbd);color:var(--v-dry-ink,#3b331a)}.ds-possible{background:var(--v-possible,#c6dcef);color:var(--v-possible-ink,#12314d)}.ds-rain{background:var(--v-rain,#5f9bd6);color:var(--v-rain-ink,#071a2e)}.ds-heavy{background:var(--v-heavy,#27347e);color:var(--v-heavy-ink,#fff)}.ds-nodata{background:repeating-linear-gradient(135deg,var(--v-nodata,#e3e6e2) 0 4px,var(--sheet,#fbfbf9) 4px 8px);color:var(--v-nodata-ink,#4b5660)}"
    },
    {
      "name": "Departure Calendar",
      "kind": "custom",
      "refersTo": "calendar-row",
      "description": "Signature takwim grid: departures as hairline-ruled rows; current ringed vermilion, best ringed ink.",
      "html": "<div class=\"ds-cal\"><button class=\"ds-row\"><span class=\"ds-t\">07:20</span><span class=\"ds-days\"><i class=\"d\"></i><i class=\"r\"></i><i class=\"r\"></i><i class=\"d\"></i></span><span class=\"ds-w\">10</span></button><button class=\"ds-row ds-cur\"><span class=\"ds-t\">07:30</span><span class=\"ds-days\"><i class=\"d\"></i><i class=\"r\"></i><i class=\"h\"></i><i class=\"d\"></i></span><span class=\"ds-w\">15</span></button><button class=\"ds-row ds-best\"><span class=\"ds-t\">08:30</span><span class=\"ds-days\"><i class=\"d\"></i><i class=\"d\"></i><i class=\"d\"></i><i class=\"d\"></i></span><span class=\"ds-w\">0</span></button></div>",
      "css": ".ds-cal{display:grid;max-width:360px}.ds-row{display:grid;grid-template-columns:56px 1fr 52px;align-items:center;gap:8px;min-height:44px;padding:0 4px;border:0;border-top:1px solid var(--rule,#d6dbd5);background:transparent;color:var(--ink,#14202b);border-radius:4px;cursor:pointer;width:100%}.ds-row:hover{background:var(--sheet-2,#f2f4f0)}.ds-row:focus-visible{outline:none;box-shadow:0 0 0 3px var(--sheet,#fbfbf9),0 0 0 5px var(--now,#c13d26)}.ds-t{font:500 15px/1 'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums;justify-self:start}.ds-w{font:500 14px/1 'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums;text-align:right;color:var(--ink-2,#44525f)}.ds-days{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;height:28px}.ds-days i{border-radius:2px}.ds-days .d{background:var(--v-dry,#eadfbd)}.ds-days .r{background:var(--v-rain,#5f9bd6)}.ds-days .h{background:var(--v-heavy,#27347e)}.ds-cur{box-shadow:inset 0 0 0 2px var(--now,#c13d26)}.ds-cur .ds-t{font-weight:700}.ds-best .ds-t{padding:3px 5px;margin-left:-5px;border:1.5px solid var(--ink,#14202b);border-radius:999px}"
    },
    {
      "name": "Best-time Chip",
      "kind": "card",
      "refersTo": "best-chip",
      "description": "Tabular time, arrival sentence, sparkline (current vermilion, best ink).",
      "html": "<button class=\"ds-best\"><span class=\"ds-bt\">08:30</span><span class=\"ds-bs\">Arrive ~09:30 dry instead of ~15 min in rain.</span><svg width=\"92\" height=\"30\"><rect x=\"1\" y=\"14\" width=\"8\" height=\"16\" fill=\"#5f9bd6\"/><rect x=\"11\" y=\"6\" width=\"8\" height=\"24\" fill=\"#c13d26\"/><rect x=\"21\" y=\"21\" width=\"8\" height=\"9\" fill=\"#14202b\"/><rect x=\"31\" y=\"28\" width=\"8\" height=\"2\" fill=\"#b7beb6\"/></svg></button>",
      "css": ".ds-best{width:100%;max-width:380px;min-height:56px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:8px 14px;border-radius:6px;border:1px solid var(--rule-strong,#b7beb6);background:var(--sheet,#fbfbf9);color:var(--ink,#14202b);text-align:left;cursor:pointer}.ds-best:hover{background:var(--sheet-2,#f2f4f0)}.ds-best:focus-visible{outline:none;box-shadow:0 0 0 3px var(--sheet,#fbfbf9),0 0 0 5px var(--now,#c13d26)}.ds-bt{font:600 24px/1 'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums}.ds-bs{font:400 13px/1.3 system-ui,sans-serif;color:var(--ink-2,#44525f)}"
    },
    {
      "name": "Caveat Badge",
      "kind": "chip",
      "refersTo": "badge-caveat",
      "description": "Hairline warn badge; never a tinted fill.",
      "html": "<span class=\"ds-caveat\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.5 21.5 20h-19ZM12 10v4.5M12 17.2v.3\"/></svg>1 source down</span>",
      "css": ".ds-caveat{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;border:1px solid color-mix(in srgb,var(--warn,#8a5a00) 55%,transparent);background:transparent;color:var(--ink,#14202b);font:600 13px/1.3 system-ui,sans-serif}.ds-caveat svg{color:var(--warn,#8a5a00)}"
    },
    {
      "name": "Source Chip",
      "kind": "chip",
      "refersTo": "source-chip",
      "description": "Hairline pill with a shape-coded status mark.",
      "html": "<span class=\"ds-chip\"><i class=\"ds-st ok\"></i>Open-Meteo <small>2 min</small></span> <span class=\"ds-chip failed\"><i class=\"ds-st\"></i>MET Norway <small>failed</small></span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border-radius:999px;border:1px solid var(--rule,#d6dbd5);background:var(--sheet,#fbfbf9);font:400 13px/1.3 system-ui,sans-serif;color:var(--ink,#14202b)}.ds-chip small{color:var(--ink-3,#5f6b76);font-size:13px}.ds-st{width:8px;height:8px;border-radius:50%}.ds-st.ok{background:var(--ok,#2c6e49)}.ds-chip.failed{border-color:color-mix(in srgb,var(--bad,#a8321f) 45%,var(--rule,#d6dbd5))}.ds-chip.failed .ds-st{border-radius:1px;box-shadow:inset 0 0 0 2px var(--bad,#a8321f)}.ds-chip.failed small{color:var(--bad,#a8321f)}"
    }
  ],
  "narrative": {
    "northStar": "The Takwim",
    "overview": "RainCheck is set like the printed wall calendar that hangs in every Malaysian kitchen and office: a solid ink-teal month band at the top, big condensed numerals in a strict grid, flat process-colour fills for the days that matter, and small annotations in the corners. The drive is a takwim row. Each five-minute stretch is a cell with a tabular time, a place note and a flat verdict fill. The departure scan is a full calendar page, with departures as rows and stretches as columns.\n\nThe system is calm and printed, not alarming and glowing. Rain is normal here, so the verdict ramp stays in one sand-to-indigo family, and no red alert or weather-app chrome appears. Paper and ink carry the page. Hairlines carry the structure. Colour is spent on the verdict ramp and on one reserved vermilion that marks \"now\" and \"selected\". The phone is sparse and puts the answer first. The 400 px desktop panel is denser but keeps the same order.\n\nThe world rejects the generic weather app: a big temperature, hourly cards, red alert banners, a dashboard of cards, and false precision.",
    "keyCharacteristics": [
      "A solid ink-teal month band holds the departure controls (direction preset, clock, scrubber).",
      "Barlow Condensed tabular numerals for every time, count and label. system-ui for reading text.",
      "A flat sand → sky → blue → indigo verdict ramp. Every verdict is paired with a drawn icon and a word.",
      "Vermilion is reserved for now/selected.",
      "The departure calendar grid is the signature component.",
      "1 px hairline rules. No cast shadows, except the sheet's lift off the map."
    ],
    "rules": [
      {
        "name": "The Reserved Vermilion Rule",
        "body": "Vermilion means \"now\" or \"selected\". It never marks \"best\", never marks weather, and never marks an error. The best departure is ringed in ink, like a holiday circled on a calendar.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Verdicts are encoded by lightness inside one sand-to-indigo family, and each one is always paired with its drawn icon and its word. A verdict is never shown by colour alone.",
        "section": "colors"
      },
      {
        "name": "The No False Dry Rule",
        "body": "Health hues never fill a surface. A warn-amber tint reads as Dry Sand, so caveats use a hairline border and an icon.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number uses `tabular-nums` in the condensed face, so times never shift while scrubbing.",
        "section": "typography"
      },
      {
        "name": "The Type-Is-Interface Rule",
        "body": "The answer sentence is set large and stands on the sheet with no card around it.",
        "section": "typography"
      },
      {
        "name": "The Only Lift Rule",
        "body": "Only the sheet casts a shadow. Pins, chips, cards and map controls are flat, and MapLibre's control shadow is removed.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pair every verdict fill with its drawn icon and its word (Dry, Possible, Rain, Heavy, No data).",
      "**Do** set every time, count and duration in Barlow Condensed with `tabular-nums`.",
      "**Do** ring the best departure in ink (1.5px pill) and keep vermilion for the current departure and the selected stretch.",
      "**Do** separate sections and calendar rows with 1px hairlines instead of boxes.",
      "**Do** draw caveats as hairline badges (warn at 55% border, ink text, warn icon).",
      "**Do** keep every target at 44px or more and every readable text at 12px or more.",
      "**Do** hedge thin-data verdicts in words (\"Likely rain…\", \"1 of 6 sources answered\") instead of dimming the colour.",
      "**Do** draw missing data as the hatch, never as a flat fill."
    ],
    "donts": [
      "**Don't** use vermilion for \"best\", for weather, or for errors.",
      "**Don't** fill a caveat or warning badge with a tint of warn. Amber at low alpha reads as Dry Sand.",
      "**Don't** put a small uppercase kicker or eyebrow label above a number. The number and its sentence carry the meaning, and section headings name sections.",
      "**Don't** use red/green or any second hue family for verdict levels.",
      "**Don't** add drop shadows to pins, chips, cards or map controls. Only the sheet lifts.",
      "**Don't** nest cards, or put the answer sentence in a card.",
      "**Don't** use emoji or Unicode glyphs (☀ ⛅ ☂ ⛈ ★) as icons.",
      "**Don't** show false precision (\"37% at 08:23\") or leave a shimmer running in an error state."
    ]
  }
}
